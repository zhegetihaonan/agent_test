# ===== LLM =====
# API Key 不要提交到 Git
OPENAI_API_KEY=your_api_key_here

# 默认使用当前配置的模型，可按你的 API 账号实际可用模型修改
OPENAI_MODEL=gpt-5.6-luna

# 如果使用 OpenAI 官方 API，留空即可。
# 如果是公司内部/兼容 OpenAI API 的网关，填类似：
# OPENAI_BASE_URL=http://your-gateway/v1
OPENAI_BASE_URL=

# ===== RabbitMQ =====
RABBITMQ_CONTAINER=rabbitmq

# 只分析名称包含 task 的队列
QUEUE_PATTERN=task

# 这里只作为 Agent 判断的参考阈值，目前不会自动 purge
QUEUE_THRESHOLD=500000

# ===== 历史数据 =====
DAILY_INFO_FILE=./data/daily_info.txt

# ===== Docker logs =====
DOCKER_LOG_HOURS=24
DOCKER_LOG_MAX_CHARS=12000

# ===== 企业微信 =====
WECOM_WEBHOOK=your_wecom_webhook_here

LOG_LEVEL=INFO
